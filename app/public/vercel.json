{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/mint/:address", "destination": "/mint" },
    { "source": "/token/:address", "destination": "/token" }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        { "type": "query", "key": "chain", "value": "rh" },
        { "type": "header", "key": "user-agent",
          "value": ".*(facebookexternalhit|Twitterbot|Slackbot|Discordbot|TelegramBot|WhatsApp|LinkedInBot|redditbot).*" }
      ],
      "destination": "/share-rh",
      "permanent": false
    },
    {
      "source": "/mint/:address(0x[0-9a-fA-F]{40})",
      "has": [
        { "type": "header", "key": "user-agent",
          "value": ".*(facebookexternalhit|Twitterbot|Slackbot|Discordbot|TelegramBot|WhatsApp|LinkedInBot|redditbot).*" }
      ],
      "destination": "/share-rh",
      "permanent": false
    }
  ]
}
