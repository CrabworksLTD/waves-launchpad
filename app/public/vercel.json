{
  "cleanUrls": true,
  "buildCommand": null,
  "installCommand": "npm install",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/mint/:address",
      "destination": "/mint"
    },
    {
      "source": "/token/:address",
      "destination": "/token"
    },
    {
      "source": "/m/:id/:file",
      "destination": "/api/meta?id=:id&file=:file"
    },
    {
      "source": "/dex/:path",
      "destination": "/api/dex?path=:path"
    }
  ],
  "headers": [
    {
      "source": "/(.*).js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "chain",
          "value": "rh"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Twitterbot|Slackbot|Discordbot|TelegramBot|WhatsApp|LinkedInBot|redditbot).*"
        }
      ],
      "destination": "/share-rh",
      "permanent": false
    },
    {
      "source": "/mint/:address",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Twitterbot|Slackbot|Discordbot|TelegramBot|WhatsApp|LinkedInBot|redditbot).*"
        }
      ],
      "missing": [
        {
          "type": "query",
          "key": "hp"
        }
      ],
      "destination": "/api/share?id=:address&to=mint",
      "permanent": false
    },
    {
      "source": "/token/:address",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Twitterbot|Slackbot|Discordbot|TelegramBot|WhatsApp|LinkedInBot|redditbot).*"
        }
      ],
      "missing": [
        {
          "type": "query",
          "key": "hp"
        }
      ],
      "destination": "/api/share?id=:address&to=token",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/keeper",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/indexer",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/rh-indexer",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/verify",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/rh-keeper",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/rh-keeper-nft",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/launchlab-keeper",
      "schedule": "0 * * * *"
    }
  ]
}
