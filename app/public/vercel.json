{
  "cleanUrls": true,
  "buildCommand": null,
  "installCommand": "npm install",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/mint/:address",
      "destination": "/mint"
    },
    {
      "source": "/token/:address",
      "destination": "/token"
    },
    {
      "source": "/m/:id/:file",
      "destination": "/api/meta?id=:id&file=:file"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "chain",
          "value": "rh"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Twitterbot|Slackbot|Discordbot|TelegramBot|WhatsApp|LinkedInBot|redditbot).*"
        }
      ],
      "destination": "/share-rh",
      "permanent": false
    },
    {
      "source": "/mint/:address",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Twitterbot|Slackbot|Discordbot|TelegramBot|WhatsApp|LinkedInBot|redditbot).*"
        }
      ],
      "missing": [
        {
          "type": "query",
          "key": "hp"
        }
      ],
      "destination": "/api/share?id=:address&to=mint",
      "permanent": false
    },
    {
      "source": "/token/:address",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Twitterbot|Slackbot|Discordbot|TelegramBot|WhatsApp|LinkedInBot|redditbot).*"
        }
      ],
      "missing": [
        {
          "type": "query",
          "key": "hp"
        }
      ],
      "destination": "/api/share?id=:address&to=token",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/keeper",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/indexer",
      "schedule": "*/10 * * * *"
    }
  ]
}
